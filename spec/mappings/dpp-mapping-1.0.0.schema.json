{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.sort4circ.eu/mappings/dpp/1.0.0/schema",
  "title": "SORT4CIRC DPP mapping package 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingVersion", "jsonSchemaVersion", "ontologyVersionIRI",
    "jsonNamespace", "xmlNamespace", "rdfNamespace", "coverageScope", "rows"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "$id": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "mappingVersion": {"const": "1.0.0"},
    "jsonSchemaVersion": {"const": "1.0.0"},
    "ontologyVersionIRI": {"type": "string", "format": "uri"},
    "jsonNamespace": {"type": "string", "format": "uri"},
    "xmlNamespace": {"type": "string", "format": "uri"},
    "rdfNamespace": {"type": "string", "format": "uri"},
    "coverageScope": {"const": "all schema-defined exchange fields"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingId", "mappingVersion", "jsonPath", "xmlXPath",
        "rdfSubjectType", "rdfProperty", "rdfConstruct", "datatype",
        "cardinality", "obligation", "controlledVocabulary", "unitRule",
        "source", "semanticMeaning", "notes"
      ],
      "properties": {
        "mappingId": {"type": "string", "minLength": 1},
        "mappingVersion": {"const": "1.0.0"},
        "jsonPath": {"type": "string", "minLength": 1},
        "xmlXPath": {"type": "string", "pattern": "^/dpp:dpp/"},
        "rdfSubjectType": {"type": "string", "pattern": "^s4c:"},
        "rdfProperty": {"$ref": "#/$defs/nullableString"},
        "rdfConstruct": {"$ref": "#/$defs/nullableString"},
        "datatype": {"enum": ["object", "xsd:anyURI", "xsd:boolean", "xsd:date", "xsd:dateTime", "xsd:decimal", "xsd:integer", "xsd:string"]},
        "cardinality": {"enum": ["0..1", "1", "0..n", "1..n"]},
        "obligation": {"enum": ["mandatory", "conditional", "optional"]},
        "controlledVocabulary": {"$ref": "#/$defs/nullableString"},
        "unitRule": {"$ref": "#/$defs/nullableString"},
        "source": {"type": "string", "minLength": 1},
        "semanticMeaning": {"type": "string", "minLength": 1},
        "notes": {"$ref": "#/$defs/nullableString"}
      },
      "allOf": [
        {"anyOf": [{"required": ["rdfProperty"], "properties": {"rdfProperty": {"type": "string"}}}, {"required": ["rdfConstruct"], "properties": {"rdfConstruct": {"type": "string"}}}]}
      ]
    }
  }
}
