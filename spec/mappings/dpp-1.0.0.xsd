<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           targetNamespace="https://data.sort4circ.eu/dpp/1.0.0"
           xmlns:dpp="https://data.sort4circ.eu/dpp/1.0.0"
           elementFormDefault="qualified"
           xpathDefaultNamespace="##targetNamespace"
           vc:minVersion="1.1"
           version="1.0.0">
  <xs:annotation>
    <xs:documentation>
      XSD 1.1 XML projection of the normative DPP JSON Schema 1.0.0.
      Assertions enforce the profile's conditional identity, carrier,
      observation, transformation and sorting rules. JSON Schema remains the
      normative JSON validation path.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="SemVerType">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OffsetType">
    <xs:restriction base="xs:string"><xs:pattern value="[+-][0-9]{2}:[0-9]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Sha256Type">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9a-f]{64}"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="QuantityType">
    <xs:all>
      <xs:element name="value" type="xs:decimal"/>
      <xs:element name="unit" type="xs:string"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="ConfidenceType">
    <xs:all>
      <xs:element name="value" type="xs:decimal"/>
      <xs:element name="scale" type="xs:string"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="IdentityType">
    <xs:all>
      <xs:element name="granularity" type="xs:string"/>
      <xs:element name="modelId" type="xs:string" minOccurs="0"/>
      <xs:element name="batchId" type="xs:string" minOccurs="0"/>
      <xs:element name="itemId" type="xs:string" minOccurs="0"/>
      <xs:element name="epc" type="xs:string" minOccurs="0"/>
      <xs:element name="sampleId" type="xs:string" minOccurs="0"/>
      <xs:element name="sourceRecordId" type="xs:string" minOccurs="0"/>
    </xs:all>
    <xs:assert test="granularity ne 'item' or exists(itemId)"/>
    <xs:assert test="granularity ne 'batch' or exists(batchId)"/>
    <xs:assert test="granularity ne 'model' or exists(modelId)"/>
  </xs:complexType>
  <xs:complexType name="CarrierType">
    <xs:all>
      <xs:element name="carrierId" type="xs:anyURI"/>
      <xs:element name="carrierType" type="xs:string"/>
      <xs:element name="encodingScheme" type="xs:string"/>
      <xs:element name="encodedIdentifier" type="xs:string"/>
      <xs:element name="resolverUri" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="bindingStatus" type="xs:string"/>
      <xs:element name="boundAt" type="xs:dateTime"/>
      <xs:element name="boundBy" type="xs:anyURI"/>
      <xs:element name="closedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="placement" type="xs:string" minOccurs="0"/>
    </xs:all>
    <xs:assert test="bindingStatus = 'commissioned' or exists(closedAt)"/>
  </xs:complexType>
  <xs:complexType name="CarriersType">
    <xs:sequence><xs:element name="carrier" type="dpp:CarrierType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="ProductType">
    <xs:all>
      <xs:element name="articleClass" type="xs:string"/>
      <xs:element name="fabricConstruction" type="xs:string" minOccurs="0"/>
      <xs:element name="colourPrimary" type="xs:string" minOccurs="0"/>
      <xs:element name="sizeDesignation" type="xs:string" minOccurs="0"/>
      <xs:element name="mass" type="dpp:QuantityType" minOccurs="0"/>
      <xs:element name="condition" type="xs:string" minOccurs="0"/>
      <xs:element name="qualityGrade" type="xs:string" minOccurs="0"/>
      <xs:element name="technicalFlags" minOccurs="0">
        <xs:complexType><xs:sequence><xs:element name="technicalFlag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="MaterialObservationType">
    <xs:all>
      <xs:element name="observationId" type="xs:anyURI"/>
      <xs:element name="fibreType" type="xs:string"/>
      <xs:element name="percentage" type="xs:decimal" minOccurs="0"/>
      <xs:element name="percentageBasis" type="xs:string" minOccurs="0"/>
      <xs:element name="valueStatus" type="xs:string"/>
      <xs:element name="method" type="xs:string"/>
      <xs:element name="sourceOrganisationId" type="xs:anyURI"/>
      <xs:element name="sourceSystemId" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="observedAt" type="xs:dateTime"/>
      <xs:element name="confidence" type="dpp:ConfidenceType" minOccurs="0"/>
      <xs:element name="evidenceRef" type="xs:anyURI" minOccurs="0"/>
    </xs:all>
    <xs:assert test="not(exists(percentage)) or exists(percentageBasis)"/>
    <xs:assert test="valueStatus = 'supplied' or not(exists(percentage))"/>
  </xs:complexType>
  <xs:complexType name="MaterialObservationsType">
    <xs:sequence><xs:element name="materialObservation" type="dpp:MaterialObservationType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="ComponentType">
    <xs:all>
      <xs:element name="componentId" type="xs:anyURI"/>
      <xs:element name="componentType" type="xs:string"/>
      <xs:element name="parentComponentId" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="materialObservationRefs" minOccurs="0">
        <xs:complexType><xs:sequence><xs:element name="materialObservationRef" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="mass" type="dpp:QuantityType" minOccurs="0"/>
      <xs:element name="separable" type="xs:boolean" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="ComponentsType">
    <xs:sequence><xs:element name="component" type="dpp:ComponentType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="LifecycleEventType">
    <xs:all>
      <xs:element name="eventId" type="xs:anyURI"/>
      <xs:element name="eventType" type="xs:string"/>
      <xs:element name="eventTime" type="xs:dateTime"/>
      <xs:element name="eventTimeZoneOffset" type="dpp:OffsetType"/>
      <xs:element name="recordedAt" type="xs:dateTime"/>
      <xs:element name="actorOrganisationId" type="xs:anyURI"/>
      <xs:element name="sourceSystemId" type="xs:anyURI"/>
      <xs:element name="facilityId" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="readPointId" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="bizStep" type="xs:string" minOccurs="0"/>
      <xs:element name="disposition" type="xs:string" minOccurs="0"/>
      <xs:element name="inputRefs" minOccurs="0">
        <xs:complexType><xs:sequence><xs:element name="inputRef" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="outputRefs" minOccurs="0">
        <xs:complexType><xs:sequence><xs:element name="outputRef" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="correctsEventId" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="evidenceRef" type="xs:anyURI" minOccurs="0"/>
    </xs:all>
    <xs:assert test="eventType ne 'transformation' or (exists(inputRefs) and exists(outputRefs))"/>
  </xs:complexType>
  <xs:complexType name="LifecycleEventsType">
    <xs:sequence><xs:element name="lifecycleEvent" type="dpp:LifecycleEventType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="SortingDecisionType">
    <xs:all>
      <xs:element name="decisionId" type="xs:anyURI"/>
      <xs:element name="basedOnObservations">
        <xs:complexType><xs:sequence><xs:element name="observationRef" type="xs:anyURI" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="basedOnRecordVersion" type="xs:positiveInteger" minOccurs="0"/>
      <xs:element name="ruleSetId" type="xs:anyURI"/>
      <xs:element name="ruleSetVersion" type="dpp:SemVerType"/>
      <xs:element name="sortingCategory" type="xs:string"/>
      <xs:element name="route" type="xs:string" minOccurs="0"/>
      <xs:element name="decidedAt" type="xs:dateTime"/>
      <xs:element name="decidedBy" type="xs:anyURI"/>
      <xs:element name="outcomeStatus" type="xs:string"/>
      <xs:element name="overrideReason" type="xs:string" minOccurs="0"/>
    </xs:all>
    <xs:assert test="outcomeStatus ne 'overridden' or exists(overrideReason)"/>
  </xs:complexType>
  <xs:complexType name="SortingDecisionsType">
    <xs:sequence><xs:element name="sortingDecision" type="dpp:SortingDecisionType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="EnvironmentalValueType">
    <xs:all>
      <xs:element name="metricType" type="xs:string"/>
      <xs:element name="quantity" type="dpp:QuantityType"/>
      <xs:element name="functionalUnit" type="xs:string"/>
      <xs:element name="systemBoundary" type="xs:string"/>
      <xs:element name="processStage" type="xs:string"/>
      <xs:element name="geography" type="xs:string"/>
      <xs:element name="periodStart" type="xs:date"/>
      <xs:element name="periodEnd" type="xs:date"/>
      <xs:element name="method" type="xs:string"/>
      <xs:element name="allocationRule" type="xs:string"/>
      <xs:element name="factorSource" type="xs:string"/>
      <xs:element name="factorVersion" type="xs:string"/>
      <xs:element name="dataQuality" type="xs:string" minOccurs="0"/>
      <xs:element name="responsibleOrganisationId" type="xs:anyURI"/>
      <xs:element name="evidenceRef" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="custodyModel" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="EnvironmentalValuesType">
    <xs:sequence><xs:element name="environmentalValue" type="dpp:EnvironmentalValueType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="IntegrityEntryType">
    <xs:all>
      <xs:element name="evidenceId" type="xs:anyURI"/>
      <xs:element name="subjectRef" type="xs:anyURI"/>
      <xs:element name="subjectVersion" type="xs:positiveInteger"/>
      <xs:element name="canonicalisation" type="xs:string"/>
      <xs:element name="digestAlgorithm" type="xs:string"/>
      <xs:element name="digestValue" type="dpp:Sha256Type"/>
      <xs:element name="evidenceState" type="xs:string"/>
      <xs:element name="createdAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="ledgerNetworkId" type="xs:string" minOccurs="0"/>
      <xs:element name="transactionRef" type="xs:string" minOccurs="0"/>
      <xs:element name="confirmedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="attempts" type="xs:nonNegativeInteger" minOccurs="0"/>
      <xs:element name="lastReasonCode" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="IntegrityType">
    <xs:sequence><xs:element name="integrityEntry" type="dpp:IntegrityEntryType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <xs:complexType name="DppType">
    <xs:all>
      <xs:element name="dppId" type="xs:anyURI"/>
      <xs:element name="schemaVersion" type="dpp:SemVerType"/>
      <xs:element name="recordVersion" type="xs:positiveInteger"/>
      <xs:element name="status" type="xs:string"/>
      <xs:element name="supersededBy" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="updatedAt" type="xs:dateTime"/>
      <xs:element name="responsibleOperatorId" type="xs:anyURI"/>
      <xs:element name="registryIdentifier" type="xs:string" minOccurs="0"/>
      <xs:element name="accessPolicyVersion" type="dpp:SemVerType" minOccurs="0"/>
      <xs:element name="identity" type="dpp:IdentityType"/>
      <xs:element name="carriers" type="dpp:CarriersType" minOccurs="0"/>
      <xs:element name="product" type="dpp:ProductType"/>
      <xs:element name="materialObservations" type="dpp:MaterialObservationsType"/>
      <xs:element name="components" type="dpp:ComponentsType" minOccurs="0"/>
      <xs:element name="lifecycleEvents" type="dpp:LifecycleEventsType" minOccurs="0"/>
      <xs:element name="sortingDecisions" type="dpp:SortingDecisionsType" minOccurs="0"/>
      <xs:element name="environmentalValues" type="dpp:EnvironmentalValuesType" minOccurs="0"/>
      <xs:element name="integrity" type="dpp:IntegrityType" minOccurs="0"/>
    </xs:all>
    <xs:attribute name="mappingVersion" type="dpp:SemVerType" use="required" fixed="1.0.0"/>
  </xs:complexType>
  <xs:element name="dpp" type="dpp:DppType"/>
</xs:schema>
