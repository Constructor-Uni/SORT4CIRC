{
  "$id": "https://example.org/reason-codes/2.0.0",
  "version": "2.0.0",
  "released": "2026-09-08",
  "note": "Public-profile reason codes. Actions describe application responses and never physical commands.",
  "safeActions": {
    "reviewIdentifier": "Review the identifier before attempting resolution.",
    "noResolution": "Do not attempt resolution for this observation.",
    "rejectAtClient": "Apply the named public-profile recovery action; no industrial behaviour is specified.",
    "reviewRecord": "Review the record before accepting it.",
    "noEffectOnExchange": "Record the condition without changing passport exchange.",
    "retrySameEvidenceId": "Retry the simulated submission with the same evidence identifier.",
    "reconcileBeforeResubmit": "Check the submission status before retrying.",
    "investigate": "Apply the named public-profile recovery action; no industrial behaviour is specified.",
    "backOff": "Apply the named public-profile recovery action; no industrial behaviour is specified.",
    "rereadAndReapply": "Apply the named public-profile recovery action; no industrial behaviour is specified."
  },
