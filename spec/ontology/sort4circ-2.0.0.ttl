@prefix s4c:   <https://example.org/vocabulary/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
# Ontology metadata
#################################################################

<https://example.org/vocabulary/> a owl:Ontology ;
    owl:versionIRI <https://example.org/vocabulary/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    dcterms:title "Generic Textile Digital Product Passport vocabulary" ;
    dcterms:description "Educational RDF and OWL model for this repository public profile; independent of any project deployment." ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "Constructor University, SORT4CIRC" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Declared OWL 2 profile: OWL 2 DL. The EL subset excludes the disjointness and asymmetry axioms." .

#################################################################
# Classes
#################################################################

s4c:DigitalProductPassport a owl:Class ;
    skos:prefLabel "Digital product passport"@en ;
    rdfs:comment "The digital record describing one product at one declared granularity."@en .

s4c:TextileEntity a owl:Class ;
    skos:prefLabel "Textile entity"@en ;
    rdfs:comment "Abstract superclass of physical textile things. Members of the holonic containment chain from garment to fibre."@en .

s4c:Garment a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Garment"@en ;
    rdfs:comment "A finished textile article treated as one item."@en .

s4c:Fabric a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Fabric"@en ;
    rdfs:comment "A textile surface forming part of a garment."@en .

s4c:Yarn a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Yarn"@en ;
    rdfs:comment "An assembly of fibres or filaments."@en .

s4c:Filament a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Filament"@en ;
    rdfs:comment "A continuous fibre."@en .

s4c:Fibre a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Fibre"@en ;
    rdfs:comment "The smallest textile unit represented in this model."@en .

s4c:Component a owl:Class ; rdfs:subClassOf s4c:TextileEntity ;
    skos:prefLabel "Component"@en ;
    rdfs:comment "A constituent part of a garment, including non-textile hard parts."@en .

s4c:HardPoint a owl:Class ; rdfs:subClassOf s4c:Component ;
    skos:prefLabel "Hard point"@en ;
    rdfs:comment "A non-textile component such as a zip, rivet or metal button."@en .

s4c:Observation a owl:Class ;
    skos:prefLabel "Observation"@en ;
    rdfs:comment "Any statement about a product made by an identified source using an identified method."@en .

s4c:MaterialObservation a owl:Class ; rdfs:subClassOf s4c:Observation ;
    skos:prefLabel "Material observation"@en ;
    rdfs:comment "An observation about material identity or proportion."@en .

s4c:ConditionObservation a owl:Class ; rdfs:subClassOf s4c:Observation ;
    skos:prefLabel "Condition observation"@en ;
    rdfs:comment "An observation about wear, damage or contamination."@en .

s4c:SensorObservation a owl:Class ; rdfs:subClassOf s4c:Observation ;
    skos:prefLabel "Sensor observation"@en ;
    rdfs:comment "An observation produced by an instrument about a physical property."@en .

s4c:EnvironmentalValue a owl:Class ; rdfs:subClassOf s4c:Observation ;
    skos:prefLabel "Environmental value"@en ;
    rdfs:comment "A quantified environmental result stated with method and boundary."@en .

s4c:LifecycleEvent a owl:Class ;
    skos:prefLabel "Lifecycle event"@en ;
    rdfs:comment "An event in the product life. Events are appended and never replaced."@en .

s4c:ProductionEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Production event"@en .
s4c:CollectionEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Collection event"@en .
s4c:TransferEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Transfer event"@en .
s4c:IdentificationEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Identification event"@en .
s4c:InspectionEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Inspection event"@en .
s4c:SortingEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Sorting event"@en .
s4c:TransformationEvent a owl:Class ; rdfs:subClassOf s4c:LifecycleEvent ; skos:prefLabel "Transformation event"@en .

s4c:SortingDecision a owl:Class ;
    skos:prefLabel "Sorting decision"@en ;
    rdfs:comment "The application of a versioned rule set to cited observations, yielding a category."@en .

s4c:RuleSet a owl:Class ; skos:prefLabel "Rule set"@en .
s4c:SortingCategory a owl:Class ; skos:prefLabel "Sorting category"@en .
s4c:Method a owl:Class ; skos:prefLabel "Method"@en .
s4c:DataCarrier a owl:Class ; skos:prefLabel "Data carrier"@en .
s4c:CarrierBinding a owl:Class ; skos:prefLabel "Carrier binding"@en ;
    rdfs:comment "The time-bounded association between a carrier and a passport."@en .
s4c:Organisation a owl:Class ; skos:prefLabel "Organisation"@en ;
    rdfs:comment "A legal entity accountable for data or an action. Never a natural person."@en .
s4c:Facility a owl:Class ; skos:prefLabel "Facility"@en .
s4c:ReadPoint a owl:Class ; skos:prefLabel "Read point"@en .
s4c:SourceSystem a owl:Class ; skos:prefLabel "Source system"@en .
s4c:IntegrityEvidence a owl:Class ; skos:prefLabel "Integrity evidence"@en ;
    rdfs:comment "A digest of a specific subject version together with the anchoring state."@en .

#################################################################
# Object properties
#################################################################

s4c:describes a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:TextileEntity ;
    skos:prefLabel "describes"@en .

s4c:describedBy a owl:ObjectProperty ; owl:inverseOf s4c:describes ;
    skos:prefLabel "described by"@en .

s4c:hasCarrierBinding a owl:ObjectProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:CarrierBinding ;
    skos:prefLabel "has carrier binding"@en .

s4c:bindsCarrier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:CarrierBinding ; rdfs:range s4c:DataCarrier ;
    skos:prefLabel "binds carrier"@en .

s4c:hasComponent a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain s4c:TextileEntity ; rdfs:range s4c:Component ;
    skos:prefLabel "has component"@en .

s4c:partOf a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    owl:inverseOf s4c:hasComponent ;
    rdfs:domain s4c:Component ; rdfs:range s4c:TextileEntity ;
    skos:prefLabel "part of"@en .

s4c:hasObservation a owl:ObjectProperty ;
    rdfs:domain s4c:TextileEntity ; rdfs:range s4c:Observation ;
    skos:prefLabel "has observation"@en ;
    rdfs:comment "Not functional. Multiple disagreeing observations are permitted by design."@en .

s4c:observedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:Observation ; rdfs:range s4c:Organisation ;
    skos:prefLabel "observed by"@en .

s4c:producedBySystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:Observation ; rdfs:range s4c:SourceSystem ;
    skos:prefLabel "produced by system"@en .

s4c:usedMethod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:Observation ; rdfs:range s4c:Method ;
    skos:prefLabel "used method"@en .

s4c:hasLifecycleEvent a owl:ObjectProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:LifecycleEvent ;
    skos:prefLabel "has lifecycle event"@en .

s4c:occurredAtFacility a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:LifecycleEvent ; rdfs:range s4c:Facility ;
    skos:prefLabel "occurred at facility"@en .

s4c:capturedAtReadPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:IdentificationEvent ; rdfs:range s4c:ReadPoint ;
    skos:prefLabel "captured at read point"@en .

s4c:performedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:LifecycleEvent ; rdfs:range s4c:Organisation ;
    skos:prefLabel "performed by"@en .

s4c:consumesInput a owl:ObjectProperty ;
    rdfs:domain s4c:TransformationEvent ; rdfs:range s4c:TextileEntity ;
    skos:prefLabel "consumes input"@en .

s4c:producesOutput a owl:ObjectProperty ;
    rdfs:domain s4c:TransformationEvent ;
    skos:prefLabel "produces output"@en .

s4c:basedOnObservation a owl:ObjectProperty ;
    rdfs:domain s4c:SortingDecision ; rdfs:range s4c:Observation ;
    skos:prefLabel "based on observation"@en .

s4c:appliedRuleSet a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:SortingDecision ; rdfs:range s4c:RuleSet ;
    skos:prefLabel "applied rule set"@en .

s4c:resultsInCategory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:SortingDecision ; rdfs:range s4c:SortingCategory ;
    skos:prefLabel "results in category"@en .

s4c:correctsEvent a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:domain s4c:LifecycleEvent ; rdfs:range s4c:LifecycleEvent ;
    skos:prefLabel "corrects event"@en .

s4c:hasIntegrityEvidence a owl:ObjectProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:IntegrityEvidence ;
    skos:prefLabel "has integrity evidence"@en .

s4c:evidenceCoversVersion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:IntegrityEvidence ;
    skos:prefLabel "evidence covers version"@en ;
    rdfs:comment "Points at a specific version resource, never at the passport as a whole."@en .

s4c:supersededBy a owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:DigitalProductPassport ;
    skos:prefLabel "superseded by"@en .

s4c:responsibleOperator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:Organisation ;
    skos:prefLabel "responsible operator"@en .

s4c:boundBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:CarrierBinding ; rdfs:range s4c:Organisation ;
    skos:prefLabel "bound by"@en .

s4c:recordedBySystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:LifecycleEvent ; rdfs:range s4c:SourceSystem ;
    skos:prefLabel "recorded by system"@en .

s4c:hasSortingDecision a owl:ObjectProperty ;
    rdfs:domain s4c:DigitalProductPassport ; rdfs:range s4c:SortingDecision ;
    skos:prefLabel "has sorting decision"@en .

s4c:decidedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:SortingDecision ; rdfs:range s4c:Organisation ;
    skos:prefLabel "decided by"@en .

s4c:hasEvidenceReference a owl:ObjectProperty ;
    skos:prefLabel "has evidence reference"@en .

s4c:evidenceSubject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain s4c:IntegrityEvidence ;
    skos:prefLabel "evidence subject"@en .

s4c:fibreType a owl:ObjectProperty ;
    rdfs:domain s4c:MaterialObservation ;
    skos:prefLabel "fibre type"@en .

s4c:articleClass a owl:ObjectProperty ;
    rdfs:domain s4c:Garment ;
    skos:prefLabel "article class"@en .

#################################################################
# Datatype properties
#################################################################

s4c:recordVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ; skos:prefLabel "record version"@en .
s4c:schemaVersion a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "schema version"@en .
s4c:percentage a owl:DatatypeProperty ; rdfs:range xsd:decimal ; skos:prefLabel "percentage"@en ;
    rdfs:comment "Meaningless without percentageBasis."@en .
s4c:percentageBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "percentage basis"@en .
s4c:valueStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "value status"@en ;
    rdfs:comment "Present on every observation, including those carrying a value."@en .
s4c:observedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "observed at"@en .
s4c:recordedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; skos:prefLabel "recorded at"@en .
s4c:eventTimeZoneOffset a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "event time zone offset"@en .
s4c:confidenceValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; skos:prefLabel "confidence value"@en .
s4c:confidenceScale a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "confidence scale"@en .
s4c:massValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; skos:prefLabel "mass value"@en .
s4c:massUnit a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "mass unit"@en .
s4c:digestValue a owl:DatatypeProperty ; rdfs:range xsd:hexBinary ; skos:prefLabel "digest value"@en .
s4c:canonicalisationProfile a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "canonicalisation profile"@en .
s4c:encodedIdentifier a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "encoded identifier"@en .
s4c:bindingStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; skos:prefLabel "binding status"@en .
s4c:passportStatus a owl:DatatypeProperty ; rdfs:domain s4c:DigitalProductPassport ; rdfs:range xsd:string ; skos:prefLabel "passport status"@en .
s4c:createdAt a owl:DatatypeProperty ; rdfs:domain s4c:DigitalProductPassport ; rdfs:range xsd:dateTime ; skos:prefLabel "created at"@en .
s4c:updatedAt a owl:DatatypeProperty ; rdfs:domain s4c:DigitalProductPassport ; rdfs:range xsd:dateTime ; skos:prefLabel "updated at"@en .
s4c:registryIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:DigitalProductPassport ; rdfs:range xsd:string ; skos:prefLabel "registry identifier"@en .
s4c:granularity a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "identity granularity"@en .
s4c:modelIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "model identifier"@en .
s4c:batchIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "batch identifier"@en .
s4c:itemIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "item identifier"@en .
s4c:epc a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "electronic product code"@en .
s4c:sampleIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "sample identifier"@en .
s4c:sourceRecordIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "source record identifier"@en .
s4c:carrierType a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:string ; skos:prefLabel "carrier type"@en .
s4c:encodingScheme a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:string ; skos:prefLabel "encoding scheme"@en .
s4c:resolverUri a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:anyURI ; skos:prefLabel "resolver URI"@en .
s4c:boundAt a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:dateTime ; skos:prefLabel "bound at"@en .
s4c:closedAt a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:dateTime ; skos:prefLabel "closed at"@en .
s4c:placement a owl:DatatypeProperty ; rdfs:domain s4c:CarrierBinding ; rdfs:range xsd:string ; skos:prefLabel "carrier placement"@en .
s4c:fabricConstruction a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "fabric construction"@en .
s4c:colourPrimary a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "primary colour"@en .
s4c:sizeDesignation a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "size designation"@en .
s4c:condition a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "condition"@en .
s4c:qualityGrade a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "quality grade"@en .
s4c:technicalFlag a owl:DatatypeProperty ; rdfs:domain s4c:TextileEntity ; rdfs:range xsd:string ; skos:prefLabel "technical flag"@en .
s4c:componentType a owl:DatatypeProperty ; rdfs:domain s4c:Component ; rdfs:range xsd:string ; skos:prefLabel "component type"@en .
s4c:separable a owl:DatatypeProperty ; rdfs:domain s4c:Component ; rdfs:range xsd:boolean ; skos:prefLabel "separable"@en .
s4c:eventType a owl:DatatypeProperty ; rdfs:domain s4c:LifecycleEvent ; rdfs:range xsd:string ; skos:prefLabel "event type"@en .
s4c:eventTime a owl:DatatypeProperty ; rdfs:domain s4c:LifecycleEvent ; rdfs:range xsd:dateTime ; skos:prefLabel "event time"@en .
s4c:businessStep a owl:DatatypeProperty ; rdfs:domain s4c:LifecycleEvent ; rdfs:range xsd:string ; skos:prefLabel "business step"@en .
s4c:disposition a owl:DatatypeProperty ; rdfs:domain s4c:LifecycleEvent ; rdfs:range xsd:string ; skos:prefLabel "disposition"@en .
s4c:basedOnRecordVersion a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:integer ; skos:prefLabel "based on record version"@en .
s4c:ruleSetVersion a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:string ; skos:prefLabel "rule set version"@en .
s4c:route a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:string ; skos:prefLabel "route"@en .
s4c:decidedAt a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:dateTime ; skos:prefLabel "decided at"@en .
s4c:outcomeStatus a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:string ; skos:prefLabel "outcome status"@en .
s4c:overrideReason a owl:DatatypeProperty ; rdfs:domain s4c:SortingDecision ; rdfs:range xsd:string ; skos:prefLabel "override reason"@en .
s4c:metricType a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "metric type"@en .
s4c:quantityValue a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:decimal ; skos:prefLabel "quantity value"@en .
s4c:quantityUnit a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "quantity unit"@en .
s4c:functionalUnit a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "functional unit"@en .
s4c:systemBoundary a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "system boundary"@en .
s4c:processStage a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "process stage"@en .
s4c:geography a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "geography"@en .
s4c:periodStart a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:date ; skos:prefLabel "period start"@en .
s4c:periodEnd a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:date ; skos:prefLabel "period end"@en .
s4c:allocationRule a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "allocation rule"@en .
s4c:factorSource a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "factor source"@en .
s4c:factorVersion a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "factor version"@en .
s4c:dataQuality a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "data quality"@en .
s4c:custodyModel a owl:DatatypeProperty ; rdfs:domain s4c:EnvironmentalValue ; rdfs:range xsd:string ; skos:prefLabel "custody model"@en .
s4c:subjectVersion a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:integer ; skos:prefLabel "subject version"@en .
s4c:digestAlgorithm a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:string ; skos:prefLabel "digest algorithm"@en .
s4c:evidenceState a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:string ; skos:prefLabel "evidence state"@en .
s4c:evidenceCreatedAt a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:dateTime ; skos:prefLabel "evidence created at"@en .
s4c:ledgerNetworkIdentifier a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:string ; skos:prefLabel "ledger network identifier"@en .
s4c:transactionReference a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:string ; skos:prefLabel "transaction reference"@en .
s4c:confirmedAt a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:dateTime ; skos:prefLabel "confirmed at"@en .
s4c:anchoringAttempts a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:nonNegativeInteger ; skos:prefLabel "anchoring attempts"@en .
s4c:lastReasonCode a owl:DatatypeProperty ; rdfs:domain s4c:IntegrityEvidence ; rdfs:range xsd:string ; skos:prefLabel "last reason code"@en .

#################################################################
# Axioms that make the model testable
#################################################################

# An observation is never the thing described. This is what allows two
# technologies to disagree about one garment without either corrupting it.
[] a owl:AllDisjointClasses ;
   owl:members ( s4c:Observation s4c:TextileEntity s4c:LifecycleEvent ) .

# A methodless or sourceless observation is inconsistent, not merely incomplete.
s4c:Observation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty s4c:usedMethod ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty s4c:observedBy ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# A decision citing no observation cannot be audited.
s4c:SortingDecision rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty s4c:basedOnObservation ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# A transformation without inputs or outputs is not a transformation.
s4c:TransformationEvent rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty s4c:consumesInput ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty s4c:producesOutput ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# A passport describing two products is inconsistent.
s4c:DigitalProductPassport rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty s4c:describes ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .
