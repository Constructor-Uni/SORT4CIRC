{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.sort4circ.eu/governance/environmental-selection/1.0.0",
  "title": "SORT4CIRC environmental platform-selection record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType", "recordVersion", "preparationDate", "preparedBy",
    "resultReporterOrRecommender", "limitApprover", "approvalDate",
    "acceptancePlan", "candidates", "deploymentAuthorization"
  ],
  "properties": {
    "recordType": { "const": "environmentalPlatformSelection" },
    "recordVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "preparationDate": { "type": "string", "format": "date" },
    "preparedBy": { "$ref": "#/$defs/person" },
    "resultReporterOrRecommender": { "$ref": "#/$defs/person" },
    "limitApprover": { "$ref": "#/$defs/person" },
    "approvalDate": { "type": "string", "format": "date" },
    "acceptancePlan": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/acceptancePlanItem" }
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "deploymentAuthorization": {
      "enum": ["architectureAndMigrationPlanningOnly", "demonstratorDeployment"]
    }
  },
  "$defs": {
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["individualId", "name", "role", "isProjectCoordinator"],
      "properties": {
        "individualId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "isProjectCoordinator": { "type": "boolean" }
      }
    },
    "acceptancePlanItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidencePath", "environmentalMetric", "systemBoundary", "evidenceSource", "maximumAcceptableResult", "rationale"],
      "properties": {
        "evidencePath": { "type": "string", "minLength": 1 },
        "environmentalMetric": { "type": "string", "minLength": 1 },
        "systemBoundary": { "type": "string", "minLength": 1 },
        "evidenceSource": { "type": "string", "minLength": 1 },
        "maximumAcceptableResult": { "type": "number" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "projectOperated", "evidencePath", "environmentalMetric", "systemBoundary", "evidenceSource", "evidenceSufficiency", "measuredResult", "passAgainstFrozenMaximum", "selected"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "projectOperated": { "type": "boolean" },
        "evidencePath": { "type": "string", "minLength": 1 },
        "environmentalMetric": { "type": "string", "minLength": 1 },
        "systemBoundary": { "type": "string", "minLength": 1 },
        "evidenceSource": { "type": "string", "minLength": 1 },
        "evidenceSufficiency": { "enum": ["sufficient", "pending", "insufficient"] },
        "measuredResult": { "type": ["number", "null"] },
        "passAgainstFrozenMaximum": { "type": ["boolean", "null"] },
        "selected": { "type": "boolean" }
      }
    }
  }
}
