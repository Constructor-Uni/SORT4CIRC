{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.sort4circ.eu/schemas/dpp/1.0.0",
  "title": "SORT4CIRC Digital Product Passport",
  "description": "Normative payload schema for the SORT4CIRC DPP profile, derived from Annex A of deliverable D4.3. This schema verifies structure, datatypes and cardinality. Controlled-value membership is verified separately against the vocabulary release, so a token that is structurally valid but absent from the declared vocabulary version is rejected with S4C-PAYLOAD-VOCAB-INVALID and not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dppId",
    "schemaVersion",
    "recordVersion",
    "status",
    "createdAt",
    "updatedAt",
    "responsibleOperatorId",
    "identity",
    "product",
    "materialObservations"
  ],
  "properties": {
    "dppId": { "$ref": "#/$defs/uri" },
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "recordVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "minLength": 1 },
    "supersededBy": { "$ref": "#/$defs/uri" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "responsibleOperatorId": { "$ref": "#/$defs/uri" },
    "registryIdentifier": { "type": "string", "minLength": 1 },
    "accessPolicyVersion": { "$ref": "#/$defs/semver" },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granularity"],
      "properties": {
        "granularity": { "type": "string", "enum": ["model", "batch", "item"] },
        "modelId": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "epc": { "type": "string", "minLength": 1 },
        "sampleId": { "type": "string", "minLength": 1 },
        "sourceRecordId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "granularity": { "const": "item" } }, "required": ["granularity"] },
          "then": { "required": ["itemId"] }
        },
        {
          "if": { "properties": { "granularity": { "const": "batch" } }, "required": ["granularity"] },
          "then": { "required": ["batchId"] }
        },
        {
          "if": { "properties": { "granularity": { "const": "model" } }, "required": ["granularity"] },
          "then": { "required": ["modelId"] }
        }
      ]
    },

    "carriers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["carrierId", "carrierType", "encodingScheme", "encodedIdentifier", "bindingStatus", "boundAt", "boundBy"],
        "properties": {
          "carrierId": { "$ref": "#/$defs/uri" },
          "carrierType": { "type": "string", "minLength": 1 },
          "encodingScheme": { "type": "string", "minLength": 1 },
          "encodedIdentifier": { "type": "string", "minLength": 1 },
          "resolverUri": { "type": "string", "format": "uri" },
          "bindingStatus": { "type": "string", "minLength": 1 },
          "boundAt": { "$ref": "#/$defs/timestamp" },
          "boundBy": { "$ref": "#/$defs/uri" },
          "closedAt": { "$ref": "#/$defs/timestamp" },
          "placement": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "bindingStatus": { "not": { "const": "commissioned" } } },
              "required": ["bindingStatus"]
            },
            "then": { "required": ["closedAt"] }
          }
        ]
      }
    },

    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleClass"],
      "properties": {
        "articleClass": { "type": "string", "minLength": 1 },
        "fabricConstruction": { "type": "string", "minLength": 1 },
        "colourPrimary": { "type": "string", "minLength": 1 },
        "sizeDesignation": { "type": "string", "minLength": 1 },
        "mass": { "$ref": "#/$defs/quantity" },
        "condition": { "type": "string", "minLength": 1 },
        "qualityGrade": { "type": "string", "minLength": 1 },
        "technicalFlags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },

    "materialObservations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/materialObservation" }
    },

    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "componentType"],
        "properties": {
          "componentId": { "$ref": "#/$defs/uri" },
          "componentType": { "type": "string", "minLength": 1 },
          "parentComponentId": { "$ref": "#/$defs/uri" },
          "materialObservationRefs": { "type": "array", "items": { "$ref": "#/$defs/uri" } },
          "mass": { "$ref": "#/$defs/quantity" },
          "separable": { "type": "boolean" }
        }
      }
    },

    "lifecycleEvents": { "type": "array", "items": { "$ref": "#/$defs/lifecycleEvent" } },
    "sortingDecisions": { "type": "array", "items": { "$ref": "#/$defs/sortingDecision" } },
    "environmentalValues": { "type": "array", "items": { "$ref": "#/$defs/environmentalValue" } },
    "integrity": { "type": "array", "items": { "$ref": "#/$defs/integrityEntry" } }
  },

  "$defs": {
    "uri": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 with an explicit offset. A timestamp without an offset is rejected."
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "description": "A bare number is never a quantity in this profile."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "scale"],
      "properties": {
        "value": { "type": "number" },
        "scale": { "type": "string", "minLength": 1 }
      },
      "description": "An unlabelled confidence number is not accepted."
    },
    "materialObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "fibreType", "valueStatus", "method", "sourceOrganisationId", "observedAt"],
      "properties": {
        "observationId": { "$ref": "#/$defs/uri" },
        "fibreType": { "type": "string", "minLength": 1 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "percentageBasis": { "type": "string", "minLength": 1 },
        "valueStatus": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "sourceOrganisationId": { "$ref": "#/$defs/uri" },
        "sourceSystemId": { "$ref": "#/$defs/uri" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidenceRef": { "$ref": "#/$defs/uri" }
      },
      "allOf": [
        {
          "if": { "required": ["percentage"] },
          "then": { "required": ["percentageBasis"] }
        },
        {
          "if": { "properties": { "valueStatus": { "not": { "const": "supplied" } } }, "required": ["valueStatus"] },
          "then": { "not": { "required": ["percentage"] } }
        }
      ]
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "eventTime", "eventTimeZoneOffset", "recordedAt", "actorOrganisationId", "sourceSystemId"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uri" },
        "eventType": { "type": "string", "minLength": 1 },
        "eventTime": { "$ref": "#/$defs/timestamp" },
        "eventTimeZoneOffset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "actorOrganisationId": { "$ref": "#/$defs/uri" },
        "sourceSystemId": { "$ref": "#/$defs/uri" },
        "facilityId": { "$ref": "#/$defs/uri" },
        "readPointId": { "$ref": "#/$defs/uri" },
        "bizStep": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 },
        "inputRefs": { "type": "array", "items": { "$ref": "#/$defs/uri" } },
        "outputRefs": { "type": "array", "items": { "$ref": "#/$defs/uri" } },
        "correctsEventId": { "$ref": "#/$defs/uri" },
        "evidenceRef": { "$ref": "#/$defs/uri" }
      },
      "allOf": [
        {
          "if": { "properties": { "eventType": { "const": "transformation" } }, "required": ["eventType"] },
          "then": { "required": ["inputRefs", "outputRefs"] }
        }
      ]
    },
    "sortingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "basedOnObservations", "ruleSetId", "ruleSetVersion", "sortingCategory", "decidedAt", "decidedBy", "outcomeStatus"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/uri" },
        "basedOnObservations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uri" } },
        "basedOnRecordVersion": { "type": "integer", "minimum": 1 },
        "ruleSetId": { "$ref": "#/$defs/uri" },
        "ruleSetVersion": { "$ref": "#/$defs/semver" },
        "sortingCategory": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "decidedAt": { "$ref": "#/$defs/timestamp" },
        "decidedBy": { "$ref": "#/$defs/uri" },
        "outcomeStatus": { "type": "string", "enum": ["issued", "confirmed", "rejected", "overridden"] },
        "overrideReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "outcomeStatus": { "const": "overridden" } }, "required": ["outcomeStatus"] },
          "then": { "required": ["overrideReason"] }
        }
      ]
    },
    "environmentalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricType", "quantity", "functionalUnit", "systemBoundary", "processStage", "geography", "periodStart", "periodEnd", "method", "allocationRule", "factorSource", "factorVersion", "responsibleOrganisationId"],
      "properties": {
        "metricType": { "type": "string", "minLength": 1 },
        "quantity": { "$ref": "#/$defs/quantity" },
        "functionalUnit": { "type": "string", "minLength": 1 },
        "systemBoundary": { "type": "string", "minLength": 1 },
        "processStage": { "type": "string", "minLength": 1 },
        "geography": { "type": "string", "minLength": 1 },
        "periodStart": { "type": "string", "format": "date" },
        "periodEnd": { "type": "string", "format": "date" },
        "method": { "type": "string", "minLength": 1 },
        "allocationRule": { "type": "string", "minLength": 1 },
        "factorSource": { "type": "string", "minLength": 1 },
        "factorVersion": { "type": "string", "minLength": 1 },
        "dataQuality": { "type": "string", "minLength": 1 },
        "responsibleOrganisationId": { "$ref": "#/$defs/uri" },
        "evidenceRef": { "$ref": "#/$defs/uri" },
        "custodyModel": { "type": "string", "minLength": 1 }
      }
    },
    "integrityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "subjectRef", "subjectVersion", "canonicalisation", "digestAlgorithm", "digestValue", "evidenceState"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/uri" },
        "subjectRef": { "$ref": "#/$defs/uri" },
        "subjectVersion": { "type": "integer", "minimum": 1 },
        "canonicalisation": { "type": "string", "minLength": 1 },
        "digestAlgorithm": { "type": "string", "minLength": 1 },
        "digestValue": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidenceState": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "ledgerNetworkId": { "type": "string", "minLength": 1 },
        "transactionRef": { "type": "string", "minLength": 1 },
        "confirmedAt": { "$ref": "#/$defs/timestamp" },
        "attempts": { "type": "integer", "minimum": 0 },
        "lastReasonCode": { "type": "string", "minLength": 1 }
      }
    }
  }
}
